{
  "name": "invaro",
  "productName": "Invaro",
  "version": "1.17.0",
  "description": "Desktop invoicing app: saved clients, rates, and PDF invoices.",
  "author": "Invaro",
  "main": "main.js",
  "private": true,
  "updateRepo": "BryceH1996/invoicer",
  "privateFiles": [
    "SYNC.md"
  ],
  "cloud": {
    "url": "https://zjhewjjldmlaaqqzrmfs.supabase.co",
    "key": "sb_publishable_UYu-4w3Nb9FZXcoWWRmowg_Fn_WOoFS"
  },
  "scripts": {
    "start": "electron .",
    "icon": "node build/make-icon.js",
    "dist": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "jspdf": "4.2.1"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.invoicer.app",
    "productName": "Invaro",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "cloud.js",
      "team.js",
      "gdrive.js",
      "gdrive.config.json",
      "preload.js",
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Invaro",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-mac.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac.${ext}"
    },
    "afterSign": "build/adhoc-sign.js"
  }
}
