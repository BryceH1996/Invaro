{
  "name": "invoicer",
  "productName": "Invoicer",
  "version": "1.3.0",
  "description": "Desktop invoicing app: saved clients, rates, and PDF invoices.",
  "author": "Invoicer",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "node build/make-icon.js",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish never && node scripts/release.js"
  },
  "dependencies": {
    "jspdf": "2.5.1"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "local.invoicer.app",
    "productName": "Invoicer",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "drive.js",
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Invoicer"
    }
  }
}
